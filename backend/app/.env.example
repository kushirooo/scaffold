# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Local PostgreSQL (docker compose up -d postgres at the repository root).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raf_pms

# Dedicated database for `npm run test:db`. The suite runs `prisma migrate deploy`
# against it and truncates its auth tables between tests; it refuses to run
# against the development database (`raf_pms`).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/raf_pms_test

# Dedicated database for `npm run test:e2e`. The suite migrates and seeds it,
# and refuses to run against the development database (`raf_pms`).
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/raf_pms_e2e

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Access-token and session lifetime in seconds (US20 will add inactivity expiry).
JWT_TTL_SECONDS=3600

# `mars_at` cookie flags. Dev/test: plain HTTP, same-site.
# Staging: Vercel and Railway are different sites — use COOKIE_SECURE=true and
# COOKIE_SAMESITE=none. SameSite=None is rejected unless the cookie is secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Portal origin, used for email links (and the default frontend origin).
FRONTEND_URL=http://localhost:3000

# Password used by `npm run db:seed` for the demo accounts (12+ characters).
SEED_PASSWORD=RafConsult!2026

# The demo seed refuses to run when NODE_ENV=production unless this is true.
ALLOW_DEMO_SEED=false

# Email delivery (US18). EMAIL_TRANSPORT=smtp|resend|memory.
# Development/test default to `memory` (in-process, no real mail). CI must stay on memory.
# Mailtrap (local development):
#   EMAIL_TRANSPORT=smtp
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=<mailtrap inbox user>
#   SMTP_PASS=<mailtrap inbox password>
# Staging/demo (Resend):
#   EMAIL_TRANSPORT=resend
#   RESEND_API_KEY=<resend-api-key>
EMAIL_TRANSPORT=memory
MAIL_FROM="RAF CONSULT MARS <no-reply@rafconsult.test>"
ADMIN_ALERT_EMAIL=admin@rafconsult.test
INVITE_TTL_SECONDS=86400
